{
  "name": "shopwave-mcp-server",
  "private": true,
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  },
  "scripts": {
    "build": "node ../../node_modules/vite/bin/vite.js build --config ui/vite.config.js",
    "start": "tsx server.js",
    "start:http": "tsx server.js --http",
    "reset": "node -e \"require('fs').rmSync('shop-data.json', { force: true }); console.log('shop-data.json removed: next start uses the seed data')\""
  }
}

{
  "name": "shopwave-storefront",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:storefront && npm run build:mcp",
    "preview": "vite preview",
    "build:storefront": "vite build",
    "build:mcp": "vite build --config mcp-app/vite.config.js",
    "start:mcp": "node mcp-server/index.js",
    "dev:mcp": "npm run build:mcp && node --watch mcp-server/index.js",
    "preview:mcp": "vite --host 127.0.0.1 --open /mcp-app/preview.html",
    "build:preview": "npm run build:mcp && node scripts/build-preview.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@modelcontextprotocol/sdk": "1.25.3",
    "@modelcontextprotocol/ext-apps": "1.1.2",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
